# Provider keys used by prebuilt agents and optional hosted embeddings.
# An API key here is not permission to send Profile or query text.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# LiteLLM model id used by AIAgent examples
# AGENTCONNECT_MODEL=gpt-4o-mini

# TelegramAIAgent
# TELEGRAM_BOT_TOKEN=

## Index
