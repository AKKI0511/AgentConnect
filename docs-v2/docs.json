{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "AgentConnect",
  "description": "Runtime for Teams of independent AI agents. Discovery, messaging, and work tracking.",
  "colors": {
    "primary": "#EAE9E6",
    "light": "#EAE9E6",
    "dark": "#EAE9E6"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#0F0E0D",
      "dark": "#0F0E0D"
    }
  },
  "fonts": {
    "heading": {
      "family": "Atkinson Hyperlegible Next",
      "weight": 500,
      "source": "/fonts/atkinson-hyperlegible-next-500.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Atkinson Hyperlegible Next",
      "weight": 400,
      "source": "/fonts/atkinson-hyperlegible-next-400.woff2",
      "format": "woff2"
    }
  },
  "favicon": "/images/favicon.svg",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/AKKI0511/AgentConnect"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/AKKI0511/AgentConnect"
    }
  },
  "search": {
    "prompt": "Search"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "contextual": {
    "options": ["copy", "view", "grok", "chatgpt", "claude"],
    "display": "header"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "This page is not here",
      "description": "It may have moved. [Start from the overview](/)."
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/overview"]
          },
          {
            "group": "Guides",
            "pages": ["guides/overview", "guides/docstrings"]
          }
        ]
      },
      {
        "tab": "Cookbooks",
        "groups": [
          {
            "group": "Examples",
            "pages": ["examples/overview"]
          }
        ]
      },
      {
        "tab": "Reference",
        "pages": {
          "$ref": "./api-pages.json"
        }
      },
      {
        "tab": "Contribute",
        "groups": [
          {
            "group": "Community",
            "pages": ["contribute"]
          }
        ]
      }
    ]
  },
  "redirects": []
}
