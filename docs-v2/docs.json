{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "AgentConnect",
  "description": "Runtime for Teams of independent agents. Discovery, messaging, and work tracking.",
  "colors": {
    "primary": "#08090A",
    "light": "#F5F5F5",
    "dark": "#08090A"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#08090A"
    }
  },
  "fonts": {
    "family": "Atkinson Hyperlegible Next",
    "heading": {
      "family": "Atkinson Hyperlegible Next",
      "weight": 600
    },
    "body": {
      "family": "Atkinson Hyperlegible Next",
      "weight": 400
    }
  },
  "favicon": {
    "light": "/images/favicon-light.svg",
    "dark": "/images/favicon-dark.svg"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/AKKI0511/AgentConnect"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/AKKI0511/AgentConnect"
    },
    "links": [
      {
        "header": "Read",
        "items": [
          {
            "label": "Install",
            "href": "/install"
          },
          {
            "label": "Concepts",
            "href": "/concepts/overview"
          },
          {
            "label": "Python API",
            "href": "/api-reference"
          }
        ]
      },
      {
        "header": "Work",
        "items": [
          {
            "label": "Guides",
            "href": "/guides/overview"
          },
          {
            "label": "Examples",
            "href": "/examples/overview"
          },
          {
            "label": "CLI",
            "href": "/integrate/cli"
          }
        ]
      },
      {
        "header": "Agents",
        "items": [
          {
            "label": "For agents",
            "href": "/agents/overview"
          },
          {
            "label": "MCP",
            "href": "/integrate/mcp"
          },
          {
            "label": "Contribute",
            "href": "/contribute"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search"
  },
  "interaction": {
    "drilldown": true
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "light-plus",
        "dark": "dark-plus"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "grok"
    ],
    "display": "toc"
  },
  "markdown": {
    "instructions": [
      "AgentConnect public terms are Team, Runtime, Membership, Session, Message, Delivery, Ticket, Thread, Address, and Skill. Keep those names. Do not substitute generic agent-framework language.",
      "The Runtime provides discovery, messaging, and work tracking. It is not a wire standard. Each agent may keep its own harness, tools, and memory."
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "That URL is not in this documentation. Use search, or start at [Install](/install)."
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "install",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/overview",
              "concepts/team",
              "concepts/agent",
              "concepts/session",
              "concepts/message",
              "concepts/ticket",
              "concepts/directory"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/overview",
              "guides/join-a-team",
              "guides/send-work",
              "guides/discover-agents"
            ]
          },
          {
            "group": "Connect",
            "pages": [
              "integrate/overview",
              "integrate/python",
              "integrate/cli",
              "integrate/mcp"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "agents/overview"
            ]
          },
          {
            "group": "Contribute",
            "pages": [
              "contribute"
            ]
          }
        ]
      },
      {
        "tab": "Examples",
        "groups": [
          {
            "group": "Recipes",
            "pages": [
              "examples/overview",
              "examples/minimal-team",
              "examples/request-reply",
              "examples/directory-search"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Libraries",
            "pages": {
              "$ref": "./api-pages.json"
            }
          }
        ]
      }
    ]
  }
}
