# =============================================
# CORE PROVIDER SETTINGS (REQUIRED)
# =============================================

# API Keys for LLM Providers (At least ONE)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# =============================================
# MODEL (OPTIONAL)
# =============================================
# LiteLLM model id used by AIAgent examples
# AGENTCONNECT_MODEL=gpt-4o-mini

# =============================================
# ADVANCED FEATURES (OPTIONAL)
# =============================================
# For Telegram Agent Functionality
# TELEGRAM_BOT_TOKEN=

# For Web Search Capabilities (e.g., Research Agent)
# TAVILY_API_KEY=

# =============================================
# PAYMENT CAPABILITIES (OPTIONAL)
# =============================================
# Coinbase Developer Platform (CDP) API Key for Agent Payments
# Required only if you enable payment features
# CDP_API_KEY_NAME=your_cdp_api_key_name
# CDP_API_KEY_PRIVATE_KEY=your_cdp_api_key_private_key

# =============================================
# VECTOR SEARCH SETTINGS (OPTIONAL)
# =============================================
# Qdrant Vector Database Settings (for remote Qdrant deployment)
# QDRANT_API_KEY=your_qdrant_api_key_here

## Demos
# To run the demo app, use `demos/.env.example`. See `demos/QUICKSTART.md`.

## Servers
# To run servers, use `agentconnect/servers/.env.example` and see `agentconnect/servers/README.md`.
