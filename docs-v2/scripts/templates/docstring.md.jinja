{# Google sections are parsed by Griffe. Markdown stays portable; no JSX in source. #}
{% for section in docstring_sections %}
{# Reviewed classes have the same contracts at their individual field anchors. #}
{% if section.kind.value != 'attributes' or class is not defined or not class.module.path.startswith(('agentconnect.core.', 'agentconnect.transport.', 'agentconnect.mcp.')) %}
{% if section.kind.value == 'text' %}
{{ section.value }}
{% elif section.kind.value == 'examples' %}
**{{ section.title or 'Examples' }}:**
{% for kind, value in section.value %}
{% if kind.value == 'examples' %}
```pycon
{{ value }}
```
{% else %}
{{ value }}
{% endif %}
{% endfor %}
{% elif section.kind.value == 'admonition' %}
**{{ section.title or section.value.kind }}:**

{{ section.value.description }}
{% else %}
**{{ section.title or section.kind.value|title }}:**
{% for item in section.value %}
- {% if item.name %}`{{ item.name }}`{% endif %}{% if item.annotation %} (`{{ item.annotation }}`){% endif %}: {{ item.description|indent(2) }}
{% endfor %}
{% endif %}
{% endif %}

{% endfor %}
