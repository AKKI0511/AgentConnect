# AgentConnect Registry Server  .env example

# Top-level server settings
AGENTCONNECT_REGISTRY_HOST=localhost
AGENTCONNECT_REGISTRY_PORT=8000
AGENTCONNECT_REGISTRY_RELOAD=false
AGENTCONNECT_REGISTRY_LOG_LEVEL=INFO

# CORS allowed origins
# Preferred JSON format (single-quoted when using .env files)
AGENTCONNECT_REGISTRY_ALLOWED_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
# Alternatively, CSV format (convenience)
# AGENTCONNECT_REGISTRY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Nested examples using double underscores
AGENTCONNECT_REGISTRY_VECTOR_SEARCH__DEPLOYMENT__TYPE=remote
AGENTCONNECT_REGISTRY_VECTOR_SEARCH__DEPLOYMENT__URL=https://qdrant.example.com:6333
AGENTCONNECT_REGISTRY_VECTOR_SEARCH__ADVANCED__TIMEOUT=60

# Single JSON override example (highest precedence)
AGENTCONNECT_REGISTRY_VECTOR_SEARCH_JSON='{"deployment":{"type":"remote","url":"..."}}'

# Secrets
# Qdrant API Key (standard env, no AgentConnect prefix)
# Set only when using remote Qdrant
# QDRANT_API_KEY=your_qdrant_api_key_here

# Notes
# - For Windows PowerShell, set env vars for the session like:
#     $env:AGENTCONNECT_REGISTRY_LOG_LEVEL = "DEBUG"
# - To run: uvicorn agentconnect.index.service:app --host 0.0.0.0 --port 8000
